---
// 覆盖 Starlight 的 SocialIcons：
// 保留配置中的社交链接（以文字形式渲染），并在前面加上「返回首页」入口（指向宣传落地页 `/`）。
const social = Astro.locals.starlightRoute?.social ?? [];---

<a class="site-home-link sl-flex" href="/" title="返回首页（宣传页）">
	<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
		<path d="M12 3.1 3 10v11h6v-6h6v6h6V10l-9-6.9Z" />
	</svg>
	<span>返回首页</span>
</a>

{
	social.map(({ label, href }) => (
		<a class="site-social-link sl-flex" href={href} rel="me" title={label}>
			{label}
		</a>
	))
}

<style>
	.site-home-link {
		align-items: center;
		gap: 0.35rem;
		padding: 0.32rem 0.75rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		white-space: nowrap;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		transition:
			background 0.18s,
			border-color 0.18s,
			color 0.18s;
	}

	.site-home-link:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-5);
		border-color: var(--sl-color-gray-4);
	}

	.site-social-link {
		align-items: center;
		padding: 0.5em;
		margin: -0.5em;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}

	.site-social-link:hover {
		color: var(--sl-color-white);
	}

	/* 窄屏只保留图标 */
	@media (max-width: 50rem) {
		.site-home-link span {
			display: none;
		}

		.site-home-link {
			padding: 0.35rem;
		}
	}
</style>
